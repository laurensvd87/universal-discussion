    "supervisorActiveSeconds": 350,
    "nodeActiveSeconds": 345,
    "originPolicyBudgetSeconds": 240,
    "maxPolicyRequestsPerBatch": 8,
    "maxPolicyRequestsOverall": 64,
    "maxPageRequestsPerBatch": 4,
    "maxPageRequestsOverall": 32,
