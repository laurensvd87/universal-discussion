      "GET",
      "HEAD"
    ],
    "resourceTypes": [
      "Document"
    ],
    "credentialsRemoved": [
      "Cookie",
      "Authorization",
      "Proxy-Authorization"
    ],
    "documents": "exact CURRENT document URL within own four batch URLs; no redirect rescue; every external subresource blocked",
    "minimumOriginSpacingMs": 2000,
    "knownRobotsRepair": "only immutable exact NL snapshot",
    "chromeDnsPinned": false,
    "completeOsEgressIsolation": false,
    "observedPrivateResponseAddress": "fatal"
  },
  "resources": {
    "rssMiB": 1536,
    "privateMiB": 1536,
    "jobCommitMiB": 1536,
    "hostPhysicalReserveMiB": 1024,
    "hostCommitReserveMiB": 1024,
    "cFreeReserveMiB": 768,
    "dFreeReserveMiB": 512,
    "maxJobPids": 128,
    "pollMs": 50,
    "nodeHeapMiB": 256,
    "resultBytes": 65536,
    "logsBytes": 65536,
    "packetBytes": 131072,
    "totalBytes": 262144,
    "prefixUtf16": 160
  },
  "freezeSchema": "current-producer-final-freeze/v1",
  "freezeFields": [
    "schema",
    "sourceHashes",
    "protocolSha256",
    "candidateSha256",
    "labelSealSha256",
    "selectionReceiptSha256",
    "targetProfiles",
    "freezeHash"
  ],
  "freezeHashRule": "SHA256(JSON.stringify(ordered freeze without freezeHash)); sourceHashes exact exported SOURCE_FILES insertion order",
  "ordering": "all eight static batches complete before browser01; each batch verifies all prior same-phase receipts; no automatic invocation or replay",
  "fitterProof": "Fixed fitter freeze and successful fit-current supervisor are extra source pins outside producer-profile recipe; exact receipt/file/selfhash/protocol/source/cleanup/result SHA links required",
  "mainDocumentAdmission": "After guard setup validate initial root about:blank frame once. Each article admits exactly one matching GET/HEAD Document in that known frame with valid Fetch/network IDs; reserve synchronously before continuation. Block same-URL subframes/reloads/duplicates/late requests; bind own response by admitted network/frame/URL and record Fetch request/response IDs separately.",
  "denominator": 32,
  "pairedArticleGroups": 32,
  "retention": "checked-policy title<=200/body<=4096 in exclusive <=128KiB packet; keep until ROOT verifies encoding/source checks; no HTML/automatic delete or blanket licence assertion",
  "validNoisyInput": "all valid bounded noisy reader input remains evaluable and wrong roots count; no post-score quality exclusion",
  "experimental": true,
  "productionValidated": false,
  "assignmentAuthority": false,
  "noAutomaticRetry": true
}
