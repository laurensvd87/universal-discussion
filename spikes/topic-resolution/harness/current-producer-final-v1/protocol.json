  "browser": {
    "batches": 8,
    "rowsPerBatch": 4,
    "wallSeconds": 180,
    "supervisorActiveSeconds": 170,
    "nodeActiveSeconds": 165,
    "completeOriginPolicyBudgetSeconds": 60,
    "policyRequestTimeoutSeconds": 5,
    "maxPolicyRequestsPerBatch": 8,
    "navigationObservationSecondsPerArticle": 20,
    "latestDclSeconds": 18,
    "snapshotAfterDclSeconds": 2,
    "maxNavigationObservationSeconds": 80,
    "maxStartupOverheadCloseAndSourceChecksSeconds": 35,
    "ownJobFinalDrainSeconds": 5,
    "snapshotsPerArticle": 1,
    "maxPausedRequests": 4096,
    "maxCdpPendingRequests": 128,
    "maxCdpMessageBytes": 4194304,
