# Private router audit downloads must never enter repository history.
*-unifi-audit-*.json
unifi-audit-private/

# Local experiment runs contain generated captures, browser profiles, caches and
# disposable databases. Preserve them on disk, but never add them to history.
# Experiment source, protocols and reviewed source maps remain visible to Git.
/spikes/topic-resolution/harness/**/output/
/spikes/topic-resolution/harness/**/output-*/
/apps/local-service/portable/integration/**/output/
/apps/local-service/portable/integration/**/output-*/
/apps/local-service/experiments/topic-encoder/**/output/
/apps/local-service/experiments/topic-encoder/**/output-*/
# Downloaded tooling is reinstallable from its checked-in package/lock files.
/spikes/topic-resolution/harness/**/node_modules/
