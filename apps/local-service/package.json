{
  "name": "@universal-discussion/local-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/cli.js",
    "backup:canonical": "node src/ops/backup-cli.js",
    "migrate:canonical": "node src/ops/migration-cli.js",
    "crawl:topics": "node src/ops/crawl-cli.js",
    "check:online-backup": "node harness/check-online-backup.js",
    "test": "node --import ../../spikes/topic-resolution/harness/deny-external-capabilities.js --test --test-isolation=none test/*.test.js",
    "test:embeddings": "node --import ../../spikes/topic-resolution/harness/deny-external-capabilities.js --test --test-isolation=none experiments/embeddings/test/*.test.js",
    "test:integration": "node --import ./harness/loopback-only-capabilities.js --test --test-isolation=none integration/*.integration.js",
    "test:portable": "npm --prefix portable test",
    "check:secrets": "node harness/scan-secrets.js"
  },
  "engines": {
    "node": ">=24"
  }
}
