    },
    {
      "id": "en-04",
      "language": "en",
      "text": "A June 2026 safety withdrawal affects Orion K7 electric kettles after overheating switches were found.",
      "provenance": "project-created-synthetic"
    },
    {
      "id": "en-05",
      "language": "en",
      "text": "Atlas acquires Lyra in February 2026. The buyer becomes the owner of the small mapping company.",
      "provenance": "project-created-synthetic"
    },
    {
      "id": "en-06",
      "language": "en",
      "text": "In February 2026, mapping startup Lyra is purchased by Atlas and becomes its subsidiary.",
      "provenance": "project-created-synthetic"
    },
    {
      "id": "en-07",
      "language": "en",
      "text": "The town council approves the Riverstone pedestrian bridge in May 2026. Construction will connect the two river banks.",
