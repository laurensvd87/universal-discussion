# Synthetic rehearsal only. Secrets are generated as private files by ops/init-secrets.js.
# No database URL, provider credentials, mail settings or owner paths belong here.
COMPOSE_PROJECT_NAME=murmingle-synthetic-rehearsal
# Linux: set to the operator's id -u / id -g; preflight refuses mismatches.
MURMINGLE_RUNTIME_UID=1000
MURMINGLE_RUNTIME_GID=1000
